# Ambientes Virtuais
.venv/
venv/
ENV/
env/

# Byte-compiled / otimizadores Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Testes e Cobertura
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# Bancos de Dados Locais e Chaves de Licença
data/*.sqlite3
data/*.sqlite3-journal
data/*.sqlite3-wal
data/*.sqlite3-shm
data/*.key
data/backups/
data/updates/
data/license.key
data/license.lic

# Logs e Diagnósticos Locais
logs/*.log
logs/crashes/
*.log

# Caches e Arquivos Temporários de Compilação
cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Treinamentos e Runs do YOLO
runs/
experiments/*/runs/
*.pt.backup
*.cache

# Relatórios e Mapas Gerados Dinamicamente
reports/*.pdf
reports/charts/*
reports/maps/*
reports/geojson/*
!reports/.gitkeep
!reports/charts/.gitkeep
!reports/maps/.gitkeep
!reports/geojson/.gitkeep

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
